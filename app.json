{
  "expo": {
    "name": "Never Have I Ever",
    "slug": "nhie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#080418"
    },
    "android": {
      "package": "com.smallkwondo.nhie",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#080418",
        "resizeMode": "contain"
      },
      "splash": {
        "image": "./assets/images/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#080418"
      }
    },
    "ios": {
      "bundleIdentifier": "com.smallkwondo.nhie",
      "buildNumber": "1.0.0",
      "splash": {
        "image": "./assets/images/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#080418"
      }
    },
    "scheme": "nhie",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e4d1cd41-8814-456c-9a9a-2a7ec7eb9057"
      }
    },
    "owner": "ilkaycitak"
  }
}